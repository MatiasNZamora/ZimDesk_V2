# App
NEXTAUTH_URL=https://zimdesk.srv1072552.hstgr.cloud
NEXTAUTH_SECRET=CAMBIAR_POR_SECRETO_ALEATORIO_MIN_32_CHARS
NEXT_PUBLIC_DOMAIN=zimdesk.srv1072552.hstgr.cloud

# Database
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DATABASE_URL=postgresql://zimdesk:CAMBIAR_POR_PASSWORD_SEGURO@db:5432/zimdesk?schema=public

# Email (SMTP)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USER=noreply@zimtech.com.ar
MAIL_PASSWORD=CAMBIAR_POR_PASSWORD_EMAIL
MAIL_FROM="ZimDesk <noreply@zimtech.com.ar>"
